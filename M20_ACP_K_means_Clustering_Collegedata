import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans

# 1. Read the college dataset
df = pd.read_csv("college_data.csv")

# 2. Display first 5 rows
print(df.head())

# 3. Select data for clustering
X = df[['Study_Hours', 'Attendance', 'Marks']]

# 4. Find inertia for different clusters
inertia = []

for i in range(1, 11):
    kmeans = KMeans(
        n_clusters=i,
        random_state=42,
        n_init=10
    )

    kmeans.fit(X)
    inertia.append(kmeans.inertia_)

# 5. Draw Elbow Graph
plt.plot(range(1, 11), inertia, marker='o')
plt.xlabel("Number of Clusters")
plt.ylabel("Inertia")
plt.title("Elbow Method")
plt.show()

# 6. Create 3 clusters
kmeans = KMeans(
    n_clusters=3,
    random_state=42,
    n_init=10
)

# 7. Assign cluster to each student
df['Cluster'] = kmeans.fit_predict(X)

# 8. Display results
print("\nStudent data with clusters:")
print(df)

# 9. Draw student clusters
plt.scatter(
    df['Study_Hours'],
    df['Marks'],
    c=df['Cluster'],
    s=100
)

plt.xlabel("Study Hours")
plt.ylabel("Marks")
plt.title("College Student Clusters")
plt.show()